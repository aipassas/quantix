# Transient temp files from local_store.atomic_write_text (unique per
# write, cleaned up on success and on failure). Only ever left behind by
# a hard kill mid-write; ignored so one can't be committed by accident.
.*.tmp
.streamlit/secrets.toml
threshold_overrides.json
collaboration_store.json

# Per-user store namespaces created by auth.py when someone signs in.
# Same local, never-committed data as the shared stores above, one
# directory per authenticated identity.
users/

# Issued API keys (hashes, never plaintext) — local credential state.
api_keys_store.json

# Digest recipients and schedule state.
digest_store.json
digest_cron.log

# Recorded holdings — real financial positions, local only.
portfolio_store.json
api_keys_usage.json
slack_alert_state.json

# Local account records: scrypt password hashes and reset-token digests.
# Nothing replayable, but it is a credential store and per-instance state,
# so it never belongs in the repository.
accounts_store.json

# Saved screeners and the quick-stats picker: the user's own configuration,
# same never-committed class as the stores above. Missed when those two
# features landed, which is how screener_templates.json turned up untracked
# in a later working tree.
screener_templates.json
screener_templates.tmp
quick_stats.json
quick_stats.tmp

# Notification read-state and rule snoozes — per-user local state, same
# never-committed class as every other store above.
notifications.json
notifications.tmp

# Coverage artifacts (PHASE 1.7)
.coverage
htmlcov/
