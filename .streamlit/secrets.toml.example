# Copy this file to .streamlit/secrets.toml (gitignored — never commit real
# credentials) to enable the "Email this report" button on the CIO Tear
# Sheet tab. Without it, that button explains it isn't configured and the
# rest of the app works exactly the same.
#
# use_tls = true uses STARTTLS on the given port (587 is the common
# STARTTLS port for Gmail, Outlook/Office365, and most providers).
#
# Alternative to this file: set the equivalent QUANTIX_SMTP_* environment
# variables instead (QUANTIX_SMTP_HOST, QUANTIX_SMTP_PORT,
# QUANTIX_SMTP_USERNAME, QUANTIX_SMTP_PASSWORD, QUANTIX_SMTP_FROM_ADDRESS,
# QUANTIX_SMTP_USE_TLS) — either source works, this file is just usually
# more convenient for a locally-run instance.

[smtp]
host = "smtp.gmail.com"
port = 587
username = "your-account@gmail.com"
# For Gmail specifically, this needs to be a 16-character App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords),
# not your normal login password.
password = "your-app-password"
from_address = "your-account@gmail.com"
use_tls = true

# =============================================================================
# SIGN-IN (optional)
# =============================================================================
# Enables the Account panel at the top of the sidebar. With this section
# absent — the default — the app runs exactly as it always has: every store
# is shared by whoever runs the instance, and the Account panel just
# explains what's missing. Nothing below is required to use Quantix.
#
# What signing in changes: watchlists, favourites, theme, thresholds, alert
# rules and saved scenarios become private to your account (stored under
# QUANTIX/users/<key>/), and Team Notes you post carry a verified name
# instead of a typed one. Team Notes themselves stay shared on purpose.
#
# PREREQUISITE: pip install -r requirements.txt (this needs Authlib), then
# restart Streamlit — a rerun is not enough for a new dependency.
#
# cookie_secret must be a long random string you generate yourself. It
# signs the session cookie, so treat it like a password:
#     python3 -c "import secrets; print(secrets.token_hex(32))"
#
# redirect_uri must end in /oauth2callback (Streamlit enforces this) and
# must match what you register with the provider EXACTLY, including port.

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "paste-a-64-char-random-hex-string-here"

# -- Google -------------------------------------------------------------------
# console.cloud.google.com -> APIs & Services -> Credentials ->
# Create credentials -> OAuth client ID -> Web application.
# Add http://localhost:8501/oauth2callback as an Authorized redirect URI.
[auth.google]
client_id = "xxxxxxxx.apps.googleusercontent.com"
client_secret = "your-google-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# -- Microsoft ----------------------------------------------------------------
# portal.azure.com -> Microsoft Entra ID -> App registrations -> New
# registration. Platform "Web", redirect URI http://localhost:8501/oauth2callback.
# The client secret is under Certificates & secrets -> New client secret.
#
# The /common/ tenant below accepts any Microsoft account. For a single
# organisation, replace "common" with your tenant ID in BOTH places.
[auth.microsoft]
client_id = "your-application-client-id"
client_secret = "your-client-secret-value"
server_metadata_url = "https://login.microsoftonline.com/common/v2.0/.well-known/openid-configuration"

# -- GitHub -------------------------------------------------------------------
# GitHub CANNOT be configured directly, and this is a GitHub limitation
# rather than a missing feature here. Streamlit's sign-in requires an OIDC
# discovery document (server_metadata_url). GitHub implements plain OAuth
# 2.0 for user login, issues no id_token, and returns 404 for
# https://github.com/.well-known/openid-configuration. (The OIDC issuer at
# token.actions.githubusercontent.com is GitHub Actions workload-identity
# federation — it mints tokens for CI jobs, not for people signing in.)
#
# The supported route is an OIDC broker with GitHub as an upstream
# connection — Auth0, Okta, Keycloak, or Entra External ID all do this.
# The broker publishes discovery, so Streamlit sees an ordinary OIDC
# provider and it just works. Quantix reads its provider list from this
# file rather than a hardcoded list, so the section below needs no code
# change to take effect. Example using Auth0 with a GitHub connection:
#
# [auth.github]
# client_id = "your-auth0-application-client-id"
# client_secret = "your-auth0-application-client-secret"
# server_metadata_url = "https://YOUR-TENANT.us.auth0.com/.well-known/openid-configuration"
#
# Any other OIDC provider works the same way — name the table whatever you
# want the button to say.
